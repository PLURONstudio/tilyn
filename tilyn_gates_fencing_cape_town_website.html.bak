                            <option value="pedestrian">Pedestrian Access Gate (Galvanized + Nutec)</option>
                            <option value="fencing">Perimeter Nutec & Steel Fencing</option>
                            <option value="privacy">Privacy Slats Upgrade for Existing Gate/Fence</option>
                        </select>
                    </div>

                    <!-- 2. Select Approximate Dimensions -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase mb-2" id="labelWidth">Width / Span (Meters) *</label>
                            <select id="calcWidth" onchange="calculateEstimate()" class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-amber-500 focus:outline-none text-sm font-semibold text-slate-800">
