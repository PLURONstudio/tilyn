                    <!-- 1. Select Structure Type -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase mb-2">1. Select Project Type *</label>
                        <select id="calcType" onchange="calculateEstimate()" class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-amber-500 focus:outline-none text-sm font-semibold text-slate-800">
