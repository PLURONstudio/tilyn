                                <option value="2">2.0 Meters</option>
                                <option value="3">3.0 Meters (Standard Driveway)</option>
                                <option value="4" selected>4.0 Meters (Wide Driveway)</option>
                                <option value="5">5.0 Meters (Double Driveway)</option>
                                <option value="6">6.0 Meters (Large Span / Fence Section)</option>
                                <option value="10">10+ Meters (Perimeter Fencing)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Height (Meters) *</label>
                            <select id="calcHeight" onchange="calculateEstimate()" class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-amber-500 focus:outline-none text-sm font-semibold text-slate-800">
                                <option value="1.2">1.2m Height</option>
                                <option value="1.8" selected>1.8m Height (Standard Privacy)</option>
                                <option value="2.1">2.1m Height (High Security)</option>
