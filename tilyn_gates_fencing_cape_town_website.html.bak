    <!-- JAVASCRIPT -->
    <script>
        document.getElementById('yearSpan').textContent = new Date().getFullYear();

        // 1. Calculator Logic
        function calculateEstimate() {
            const type = document.getElementById('calcType').value;
            const width = parseFloat(document.getElementById('calcWidth').value);
            const height = parseFloat(document.getElementById('calcHeight').value);

            const addMotor = document.getElementById('addMotor').checked;
            const addSpikes = document.getElementById('addSpikes').checked;
            const addPedestrianInGate = document.getElementById('addPedestrianInGate').checked;

            let baseRatePerSqM = 1800; // ZAR per m² base
            let typeName = "";

            if (type === 'driveway') {
                baseRatePerSqM = 2200;
                typeName = "Galvanized Steel Driveway Gate with Nutec Cladding";
            } else if (type === 'pedestrian') {
                baseRatePerSqM = 2400;
                typeName = "Galvanized Steel Pedestrian Access Gate with Nutec";
            } else if (type === 'fencing') {
                baseRatePerSqM = 1600;
                typeName = "Perimeter Nutec & Steel Fencing";
            } else if (type === 'privacy') {
                baseRatePerSqM = 950;
                typeName = "Privacy Nutec Slat Upgrade for Existing Frame";
            }

            const sqMeters = width * height;
            let minEstimate = Math.round(sqMeters * baseRatePerSqM);

            // Add-ons
            if (addMotor) minEstimate += 6500;
            if (addSpikes) minEstimate += Math.round(width * 350);
            if (addPedestrianInGate) minEstimate += 2800;

            const maxEstimate = Math.round(minEstimate * 1.18);

            const minStr = 'R ' + minEstimate.toLocaleString('en-ZA');
            const maxStr = 'R ' + maxEstimate.toLocaleString('en-ZA');

            document.getElementById('priceDisplay').textContent = `${minStr} - ${maxStr}`;
            
            let extraText = [];
            if (addMotor) extraText.push('Centurion Gate Motor');
            if (addSpikes) extraText.push('Security Spikes');
            if (addPedestrianInGate) extraText.push('Internal Wicket Gate');

            const summary = `${width}m x ${height}m ${typeName}` + (extraText.length > 0 ? ` (+${extraText.join(', ')})` : '');
            document.getElementById('summaryText').textContent = summary;

            // Generate WhatsApp URL
            const waMsg = encodeURIComponent(`Hi TILYN Gates & Fencing, I used your online price calculator and would like an exact quote for:\n- Project: ${typeName}\n- Dimensions: ${width}m width x ${height}m height (${sqMeters.toFixed(1)}m²)\n- Add-ons: ${extraText.join(', ') || 'None'}\n- Estimated Price Range: ${minStr} - ${maxStr}`);
            document.getElementById('calcWhatsAppBtn').href = `https://wa.me/27781661613?text=${waMsg}`;
        }

        // Initialize Calculator
        calculateEstimate();

        // 2. FAQ Accordion Toggle
        function toggleFaq(id) {
            const content = document.getElementById(`faqContent-${id}`);
            const icon = document.getElementById(`faqIcon-${id}`);
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                icon.classList.add('rotate-180');
            } else {
                content.classList.add('hidden');
                icon.classList.remove('rotate-180');
            }
        }

        // 3. Gallery Category Filter
        function filterGallery(category) {
            const items = document.querySelectorAll('.gallery-item');
            const buttons = document.querySelectorAll('.gallery-filter-btn');

            buttons.forEach(btn => {
                btn.classList.remove('bg-amber-500', 'text-slate-950');
                btn.classList.add('bg-slate-800', 'text-slate-300');
            });

            const activeBtn = document.getElementById(`filter-${category}`);
            if (activeBtn) {
                activeBtn.classList.remove('bg-slate-800', 'text-slate-300');
                activeBtn.classList.add('bg-amber-500', 'text-slate-950');
            }

            items.forEach(item => {
                if (category === 'all' || item.getAttribute('data-category') === category) {
                    item.classList.remove('hidden');
                } else {
                    item.classList.add('hidden');
                }
            });
        }

        // 4. Lightbox Functions
        function openLightbox(imgSrc, title, desc) {
            document.getElementById('lightboxImage').src = imgSrc;
            document.getElementById('lightboxTitle').textContent = title;
            document.getElementById('lightboxDesc').textContent = desc;

            const waMsg = encodeURIComponent(`Hi TILYN Gates & Fencing, I am inquiring about a design similar to: "${title}"`);
            document.getElementById('lightboxWA').href = `https://wa.me/27781661613?text=${waMsg}`;

            document.getElementById('lightboxModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox(event) {
            if (event.target.id === 'lightboxModal') {
                closeLightboxDirect();
            }
        }

        function closeLightboxDirect() {
            document.getElementById('lightboxModal').classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        // 5. WhatsApp Form Handler
        function handleFormSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('formName').value.trim();
            const phone = document.getElementById('formPhone').value.trim();
            const area = document.getElementById('formArea').value.trim();
            const service = document.getElementById('formService').value;
            const message = document.getElementById('formMessage').value.trim();

            const textMsg = `Hi TILYN Gates %26 Fencing,%0A%0A*New Quote Request:*%0A- *Name:* ${encodeURIComponent(name)}%0A- *Phone:* ${encodeURIComponent(phone)}%0A- *Area/Suburb:* ${encodeURIComponent(area)}%0A- *Required Service:* ${encodeURIComponent(service)}%0A- *Notes/Dimensions:* ${encodeURIComponent(message || 'None')}`;

            window.open(`https://wa.me/27781661613?text=${textMsg}`, '_blank');
        }
    </script>
</body>
</html>